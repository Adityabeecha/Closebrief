# Which provider to use for narrative generation (and, in Milestone 2, embeddings).
# "openai" (default) or "anthropic".
LLM_PROVIDER=openai

# --- OpenAI (default provider) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Anthropic (only needed if LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-4-8

# Retrieval / generation tuning
RETRIEVAL_K=5
ANOMALY_Z_THRESHOLD=2.0

# --- Storage (v1.1) ---
# Local dev default: SQLite at DB_PATH. Set DATABASE_URL to run on Supabase.
DB_PATH=./data/closebrief.db

# Supabase Postgres — use the TRANSACTION pooler string (port 6543).
# Migrations derive the session pooler (5432) automatically; the direct
# db.*.supabase.co host is IPv6-only and not needed.
# DATABASE_URL=postgresql://postgres.xxxx:PASSWORD@aws-1-region.pooler.supabase.com:6543/postgres

# Vector backend: auto (pgvector when DATABASE_URL set, else FAISS) | faiss | pgvector
VECTOR_BACKEND=auto

# --- Cache (v1.1) ---
# Upstash Redis URL. Empty -> in-process cache (local dev).
# REDIS_URL=rediss://default:TOKEN@xxxx.upstash.io:6379
CACHE_ENABLED=true
CACHE_TTL_SECONDS=86400

# Environment profile: dev | staging | prod (also via APP_ENV env var;
# `.env.<profile>` overrides `.env` when present)
ENVIRONMENT=dev

# --- Auth (v1.2) ---
# When SUPABASE_URL is empty, auth is fully bypassed and every request is an
# anonymous admin (zero-config local dev). Set all three to enforce auth.
# From Supabase dashboard -> Project Settings -> API.
# SUPABASE_URL=https://xxxx.supabase.co
# SUPABASE_ANON_KEY=eyJ...              # public "anon / public" key
# SUPABASE_JWT_SECRET=your-jwt-secret   # JWT Settings -> JWT Secret (HS256)
AUTH_ENABLED=true

# --- Monitoring (v2.0) ---
# SENTRY_DSN=https://xxxx@o0.ingest.sentry.io/0

# --- Notifications (v2.1) ---
# Email (SMTP) for digest / anomaly alerts. Slack & webhook channels take their
# URL per-config in the Notifications UI, so they need no env vars.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@gmail.com
# SMTP_PASS=your-app-password
# SMTP_FROM=Closebrief <no-reply@closebrief.app>
# WEBHOOK_SECRET=change-me           # HMAC-SHA256 signs outbound webhook bodies
