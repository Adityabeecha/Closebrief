# Keep the build context (and image) small and secret-free.
.venv/
__pycache__/
*.pyc
.pytest_cache/
*.egg-info/
.git/
.github/
graphify-out/
data/*
!data/sample_fpa.csv
.env
.env.*
!.env.example
ui/mockup/
tests/
*.md
!README.md

# Local code-review tooling is not part of the production application
.venv-typesafe/
tools/typesafe_review/
review_with_typesafe.py
requirements-typesafe-review.txt
typesafe_review_report.*
typesafe_review_plan.*
.typesafe-report-*.tmp
